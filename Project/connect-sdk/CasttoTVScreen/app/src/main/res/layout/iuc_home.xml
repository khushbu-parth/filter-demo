<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@drawable/bg2_new">

    <ScrollView
        android:layout_above="@+id/AdBanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bg2_top"
                    android:adjustViewBounds="true"/>

                <FrameLayout
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:id="@+id/AdNativeBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/native_space_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true" />

                    <FrameLayout
                        android:id="@+id/fl_native_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />

                </FrameLayout>


                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:layout_margin="10dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/iuc_r_m" />

                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_auto_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:layout_margin="10dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/iuc_r_autmatic" />

                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_manual_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:layout_margin="10dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/iuc_r_mode" />
            </LinearLayout>



    </ScrollView>

    <FrameLayout
        android:id="@+id/AdBanner"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <FrameLayout
            android:id="@+id/fl_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </FrameLayout>



</RelativeLayout>
