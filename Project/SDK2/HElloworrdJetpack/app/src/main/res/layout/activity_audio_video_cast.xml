<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_plain"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:weightSum="4">

        <ImageView
            android:id="@+id/image_back"
            android:layout_width="30dp"
            android:layout_height="37dp"
            android:layout_centerVertical="true"
            android:layout_weight="1"
            android:padding="10dp"
            android:src="@mipmap/icon_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/image_cast_screen"
            app:layout_constraintStart_toEndOf="@+id/image_back"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/image_cast_screen"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@+id/exit"
            android:layout_weight="1"
            android:padding="10dp"
            android:src="@drawable/ic_cast_connect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/image_exit"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/image_exit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="10dp"
            android:visibility="gone"
            android:src="@drawable/ic_exit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/image_help"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/image_cast_screen"
            android:padding="10dp"
            android:layout_weight="1"
            android:src="@mipmap/icon_white_help"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:visibility="visible">

            <FrameLayout
                android:id="@+id/mAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:fontFamily="@font/semibold"
                android:text="Volume"
                android:layout_marginRight="25dp"
                android:textColor="@color/white"
                android:textSize="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="5dp"
                            android:visibility="gone"
                            android:backgroundTint="#12FFFFFF">

                            <ImageView
                                android:id="@+id/image_play"
                                android:layout_width="80dp"
                                android:layout_height="90dp"
                                android:scaleType="center"
                                android:src="@drawable/icon_pause_54" />


                            <TextView
                                android:id="@+id/text_play"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="10dp"
                                android:fontFamily="@font/semibold"
                                android:text="Play"
                                android:layout_marginBottom="10dp"
                                android:textColor="@color/white"
                                android:textSize="20dp" />


                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_margin="5dp"
                            android:backgroundTint="#12FFFFFF">

                            <ImageView
                                android:id="@+id/image_stop"
                                android:layout_width="80dp"
                                android:layout_height="100dp"
                                android:scaleType="center"
                                android:src="@drawable/icon_stop_54" />

                            <TextView
                                android:id="@+id/text_stop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/semibold"
                                android:text="Stop"
                                android:visibility="visible"
                                android:textColor="@color/white"
                                android:textSize="20dp" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="5dp"
                            android:backgroundTint="#12FFFFFF">

                            <ImageView
                                android:id="@+id/image_queue"
                                android:layout_width="80dp"
                                android:layout_height="90dp"
                                android:scaleType="center"
                                android:src="@drawable/icon_list_54" />


                            <TextView
                                android:id="@+id/text_queue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="10dp"
                                android:fontFamily="@font/semibold"
                                android:text="List Of Files"
                                android:layout_marginBottom="10dp"
                                android:textColor="@color/white"
                                android:textSize="20dp" />


                        </LinearLayout>


                    </LinearLayout>

                    <ImageView
                        android:id="@+id/image_mode"
                        android:layout_width="match_parent"
                        android:layout_height="93dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_video_bg"
                        android:backgroundTint="#40FA7538"
                        android:scaleType="center"
                        android:src="@mipmap/icon_video_mode_loop"
                        android:visibility="gone" />
                </LinearLayout>


                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="23dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/btn_video_bg"
                        android:backgroundTint="#40FA7538"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/image_volume_add"
                            android:layout_width="match_parent"
                            android:layout_height="105dp"
                            android:layout_weight="1"
                            android:scaleType="center"
                            android:src="@mipmap/icon_video_more" />

                        <ImageView
                            android:id="@+id/image_volume_reduce"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:scaleType="center"
                            android:src="@mipmap/icon_video_line" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_volume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="50%"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/btn_video_bg"
                android:backgroundTint="#40FA7538"
                android:orientation="vertical"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="20dp"
                    android:padding="13dp"
                    android:progressDrawable="@drawable/seekbar_progress_drawable"
                    android:thumb="@mipmap/icon_video_seekbar"
                    android:thumbOffset="0dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:id="@+id/text_play_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="26dp"
                        android:text="00:00"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_all_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="26dp"
                        android:text="05:15"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp"
                    android:layout_marginBottom="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/image_previous"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="center"
                        android:src="@mipmap/icon_video_left" />

                    <ImageView
                        android:id="@+id/image_back_off"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="center"
                        android:src="@mipmap/icon_video_backoff" />

                    <ImageView
                        android:id="@+id/image_play"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="center"
                        android:src="@mipmap/icon_video_playwhite" />

                    <ImageView
                        android:id="@+id/image_fast_forward"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="center"
                        android:src="@mipmap/icon_video_fast" />

                    <ImageView
                        android:id="@+id/image_next"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="center"
                        android:src="@mipmap/icon_video_right" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
