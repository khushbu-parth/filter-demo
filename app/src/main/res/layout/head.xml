<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@mipmap/ic_launcher" />

    <androidx.cardview.widget.CardView
        android:id="@+id/callheadopt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="60dp"
        android:visibility="gone"
        app:cardCornerRadius="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/backtocall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_back_call_head"
                android:drawablePadding="8dp"
                android:drawableTint="@color/black"
                android:padding="8dp"
                android:text="Back to call"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/speaker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/speaker_ic_new"
                android:drawablePadding="8dp"
                android:drawableTint="@color/black"
                android:padding="8dp"
                android:text="Speaker"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/mute_ic_new"
                android:drawablePadding="8dp"
                android:drawableTint="@color/black"
                android:padding="8dp"
                android:text="Mute"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/endCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/redCircle"
                android:drawableStart="@drawable/ic_disconnect_new_24dp"
                android:drawablePadding="8dp"
                android:drawableTint="@color/white"
                android:padding="8dp"
                android:text="End Call"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/revealEffectLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />
</FrameLayout>
