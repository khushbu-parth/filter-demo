<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:local="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp">

            <ImageView
                android:id="@+id/ivFloat"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ad_baseline_menu_24" />

            <ImageView
                android:id="@+id/ivInAppPurchase"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:layout_marginStart="6dp"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/iv_adtop"
                android:src="@drawable/ad_pro"
                android:visibility="visible" />

            <FrameLayout
                android:id="@+id/iv_adtop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:visibility="visible">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@drawable/ad_drawer"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/tv_counttop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_margin="8dp"
                    android:background="@drawable/ad_call_to_action_small"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:text="6"
                    android:textColor="@color/white"
                    android:textSize="8dp" />
            </FrameLayout>


        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <TextView
                android:id="@+id/testing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="Enter your Ui Code here..."
                android:textColor="@color/black"
                android:textSize="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/testing"
                android:orientation="vertical">
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/ad_native"/>

                    </LinearLayout>

                </ScrollView>
                <include layout="@layout/ad_banner"/>
            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity=""
        android:layout_marginRight="40dp"
        android:background="#DFCFCF"
        android:clickable="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:letterSpacing="0.015"
            android:maxLines="1"
            android:paddingLeft="20dp"
            android:paddingTop="35dp"
            android:paddingRight="20dp"
            android:shadowColor="@color/white"
            android:shadowRadius="4"
            android:text="@string/app_name"
            android:textColor="@color/black"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/txtVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_margin="6dp"
            android:text="Version 1.0"
            android:textColor="@color/black" />

        <LinearLayout
            android:id="@+id/ll_applayout"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_appicon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="20dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tv_appname"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingLeft="15dp"
                android:text="Testing"
                android:textColor="@color/black"
                android:textSize="14dp" />

            <TextView
                android:layout_width="30dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:background="@drawable/ad_bgtxt_ad"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="AD"
                android:textColor="@color/black"
                android:textSize="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="In between your main menu" />

        <LinearLayout
            android:id="@+id/ll_sliderad"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:gravity="center|left"
            android:orientation="horizontal">

            <ImageView
                app:tint="@color/black"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="20dp"
                android:gravity="center"
                android:src="@drawable/ad_drawer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="25dp"
                android:paddingRight="10dp"
                android:text="Hot app"
                android:textColor="@color/black"
                android:textSize="12dp" />


            <TextView
                android:id="@+id/tv_countslider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:background="@drawable/ad_call_to_action_small"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="9"
                android:textColor="@color/white"
                android:textSize="10dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="then other options" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>