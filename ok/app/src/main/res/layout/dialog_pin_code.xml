<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@color/color_transparent"
    android:paddingHorizontal="@dimen/_24sdp"
    android:paddingLeft="@dimen/_24sdp"
    android:paddingRight="@dimen/_24sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:fontFamily="@font/montserrat_medium"
            android:text="@string/enter_the_pin_code"
            android:textColor="@color/color_main"
            android:textSize="@dimen/_13ssp" />

        <EditText
            android:id="@+id/edt_pinCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:backgroundTint="@color/color_gray_2_ads"
            android:fontFamily="@font/montserrat_medium"
            android:lines="1"
            android:minHeight="48dp"
            android:textColor="@color/color_main" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp">

            <TextView
                android:id="@+id/tv_pinCodeOk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/_12sdp"
                android:fontFamily="@font/montserrat_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="@string/ok"
                android:textColor="@color/color_txt"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_pinCodeCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_16sdp"
                android:layout_toStartOf="@+id/tv_pinCodeOk"
                android:fontFamily="@font/montserrat_medium"
                android:padding="@dimen/_10sdp"
                android:text="@string/cancel_dialog"
                android:textColor="@color/color_txt"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
