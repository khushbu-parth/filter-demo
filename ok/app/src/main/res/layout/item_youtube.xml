<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/_8sdp"
    android:paddingTop="@dimen/_8sdp"
    android:paddingBottom="@dimen/_8sdp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_50sdp"
        app:cardElevation="@dimen/_6sdp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imv_itemYoutubeThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/mr_cast_thumb" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_itemYoutubeQuality"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_20sdp"
        android:background="@drawable/bg_border_height"
        android:gravity="center"
        android:text="1280p"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/tv_itemYoutubeName"
        app:layout_constraintLeft_toRightOf="@+id/cardView"
        app:layout_constraintTop_toTopOf="@+id/cardView" />

    <TextView
        android:id="@+id/tv_itemYoutubeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:ellipsize="end"
        android:fontFamily="@font/montserrat_medium"
        android:singleLine="true"
        android:text="name video"
        android:textColor="#323232"
        app:layout_constraintBottom_toBottomOf="@+id/cardView"
        app:layout_constraintLeft_toRightOf="@+id/cardView"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_itemYoutubeQuality" />

    <TextView
        android:id="@+id/tv_itemYoutubeFormat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:gravity="center"
        android:text="mp4"
        android:textColor="#151515"
        app:layout_constraintBottom_toTopOf="@+id/tv_itemYoutubeName"
        app:layout_constraintLeft_toRightOf="@+id/tv_itemYoutubeQuality"
        app:layout_constraintTop_toTopOf="@+id/cardView" />
</androidx.constraintlayout.widget.ConstraintLayout>
