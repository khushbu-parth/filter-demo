<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_main"
    android:orientation="vertical"
    android:paddingStart="@dimen/_12sdp"
    android:visibility="visible">

    <ImageView
        android:id="@+id/imv_close"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_gravity="end"
        android:layout_margin="@dimen/_8sdp"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/ic_close" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_20sdp"
        android:fontFamily="@font/montserrat_medium"
        android:gravity="center"
        android:text="@string/user_guide"
        android:textColor="@color/white"
        android:textSize="@dimen/_24ssp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:fontFamily="@font/montserrat_medium"
        android:paddingEnd="@dimen/_24sdp"
        android:text="@string/_1_your_android_device_needs_to_be_connected_to_the_same_wi_fi_network_as_your_fire_stick_tv"
        android:textColor="@color/white"
        android:textSize="@dimen/_12ssp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/montserrat_medium"
        android:paddingEnd="@dimen/_24sdp"
        android:text="@string/_2_on_fire_stick_tv_home_screen_scroll_right_and_select_settings_screen"
        android:textColor="@color/white"
        android:textSize="@dimen/_12ssp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/montserrat_medium"
        android:paddingEnd="@dimen/_24sdp"
        android:text="@string/_3_scroll_right_and_select_my_fire_tv"
        android:textColor="@color/white"
        android:textSize="@dimen/_12ssp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/montserrat_medium"
        android:paddingEnd="@dimen/_24sdp"
        android:text="@string/_4_scroll_down_and_select_developer_options"
        android:textColor="@color/white"
        android:textSize="@dimen/_12ssp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/montserrat_medium"
        android:paddingEnd="@dimen/_24sdp"
        android:text="@string/_5_turn_on_adb_debugging"
        android:textColor="@color/white"
        android:textSize="@dimen/_12ssp" />
</LinearLayout>
