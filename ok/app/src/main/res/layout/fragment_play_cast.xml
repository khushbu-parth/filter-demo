<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBg"
    android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/header"
                layout="@layout/view_header" />

            <RelativeLayout
                android:id="@+id/ctPhoto"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/main_ads_native"
                app:layout_constraintTop_toBottomOf="@+id/header">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_margin="14dp"
                    app:cardCornerRadius="10dp">

                    <com.pu.casttotv.tvcast.screenmirror.tvremote.view.SquareLinear
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.viewpager.widget.ViewPager
                            android:id="@+id/vpImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.pu.casttotv.tvcast.screenmirror.tvremote.view.SquareLinear>
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/imvPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/cvCard"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="14dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/rcvImage"
                    android:layout_below="@+id/imvPhoto"
                    android:layout_centerHorizontal="true"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/linearLayout4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_photo"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/imvPreviousPhoto"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_previous" />

                        <ImageView
                            android:id="@+id/imvPlayPhoto"
                            android:layout_width="33dp"
                            android:layout_height="33dp"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"
                            android:src="@drawable/ic_play" />

                        <ImageView
                            android:id="@+id/imvNextPhoto"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_next" />

                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvImage"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_alignParentBottom="true"
                    android:paddingHorizontal="4dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp" />


            </RelativeLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ctVideo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@+id/main_ads_native"
                app:layout_constraintTop_toBottomOf="@+id/header">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/imvVideo"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="10dp"
                            android:adjustViewBounds="true"
                            android:background="@drawable/image_corner"
                            android:src="@drawable/imv_default" />

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginVertical="5dp"
                            android:fontFamily="@font/extrabold"
                            android:lines="1"
                            android:text="@string/app_name"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginVertical="10dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="20dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_photo"
                            android:orientation="vertical"
                            android:paddingVertical="12dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <RelativeLayout
                                android:id="@+id/rl_cast_control"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/constraintLayout2">

                                <LinearLayout
                                    android:id="@+id/llTime"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:orientation="vertical">

                                    <SeekBar
                                        android:id="@+id/seekbar_time"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:max="100"
                                        android:maxHeight="10dp"
                                        android:minHeight="10dp"
                                        android:progressDrawable="@drawable/custom_seekbar"
                                        android:thumb="@drawable/ic_thumb" />

                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginHorizontal="10dp"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginTop="10dp"
                                        android:layout_marginRight="10dp">

                                        <TextView
                                            android:id="@+id/tvTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/semibold"
                                            android:text="00:00"
                                            android:textColor="@color/white"
                                            android:textSize="11sp" />

                                        <TextView
                                            android:id="@+id/tvDuration"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentEnd="true"
                                            android:fontFamily="@font/semibold"
                                            android:tag="binding_6"
                                            android:text="00:00"
                                            android:textColor="@color/white"
                                            android:textSize="11sp" />

                                    </RelativeLayout>

                                </LinearLayout>

                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/imvPreviousVideo5s"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/ic_previous" />

                                <ImageView
                                    android:id="@+id/imvPlayVideo"
                                    android:layout_width="33dp"
                                    android:layout_height="33dp"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginRight="10dp"
                                    android:src="@drawable/ic_pause" />

                                <ImageView
                                    android:id="@+id/imvNextVideo5s"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/ic_next" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginVertical="10dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="20dp"

                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_photo"
                            android:orientation="vertical"
                            android:paddingVertical="12dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <LinearLayout
                                android:id="@+id/linearLayout3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:weightSum="3"
                                app:layout_constraintTop_toTopOf="@+id/guideline9">

                                <LinearLayout
                                    android:id="@+id/ll_stopVideo"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/ripple_effect_exit"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:clickable="false"
                                        android:focusable="false"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <ImageButton
                                            android:layout_width="35dp"
                                            android:layout_height="35dp"
                                            android:background="@drawable/ic_sony_stop"
                                            android:clickable="false" />

                                    </LinearLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:fontFamily="@font/semibold"
                                        android:text="@string/cast_stop"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/ll_show_list"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/ripple_effect_exit"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:clickable="false"
                                        android:focusable="false"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <ImageButton
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:background="@drawable/ic_channel_lg"
                                            android:clickable="false" />

                                    </LinearLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:fontFamily="@font/semibold"
                                        android:text="@string/add_queue"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/imvRemote"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/ripple_effect_exit"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:clickable="false"
                                        android:focusable="false"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <ImageButton
                                            android:layout_width="15dp"
                                            android:layout_height="30dp"
                                            android:background="@drawable/ic_remote_control_2"
                                            android:clickable="false" />

                                    </LinearLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:fontFamily="@font/semibold"
                                        android:text="@string/remote"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/linearLayout5"
                                android:layout_width="match_parent"
                                android:layout_height="55dp"
                                android:layout_marginHorizontal="20dp"
                                android:layout_marginVertical="10dp"
                                android:layout_marginLeft="20dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginRight="20dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/bg_photo"
                                android:orientation="horizontal"
                                app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

                                <LinearLayout
                                    android:id="@+id/rlt_volume_down_media_player"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@drawable/ripple_effect_exit"
                                    android:gravity="center">

                                    <ImageButton
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/ic_sony_minus"
                                        android:clickable="false" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/ll_mute"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@drawable/ripple_effect_exit"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/ic_volume_play" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/rlt_volume_up_media_player"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@drawable/ripple_effect_exit"
                                    android:gravity="center">

                                    <ImageButton
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/ic_sony_plus"
                                        android:clickable="false" />

                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>


                    </LinearLayout>

                </ScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <FrameLayout
                android:id="@+id/main_ads_native"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <RelativeLayout
                    android:id="@+id/rlBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center" />

            </androidx.cardview.widget.CardView>

            <ProgressBar
                android:id="@+id/prLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/ad_native" />
</LinearLayout>

