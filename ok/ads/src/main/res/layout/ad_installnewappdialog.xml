<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


    <LinearLayout
        android:id="@+id/ll_main"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_250sdp"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_30sdp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:background="@drawable/ad_update_bg">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Update to new version"
            android:textColor="@color/white"
            android:layout_marginTop="@dimen/_50sdp"
            android:textStyle="bold"
            android:textSize="@dimen/_13sdp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/_25sdp"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_45sdp"
                android:text="We're Getting Better!"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/_13sdp" />
            <TextView
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#5C5C5C"
                android:textSize="@dimen/_11sdp"
                android:text="We added lots of new features and fix some bugs to make your experience as soomth as possible" />

        </LinearLayout>


    </LinearLayout>

        <TextView
            android:id="@+id/update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_main"
            android:layout_gravity="center"
            android:elevation="@dimen/_5sdp"
            android:text="Install Now"
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/white"
            android:paddingVertical="@dimen/_10sdp"
            android:paddingHorizontal="@dimen/_50sdp"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/_30sdp"
            android:adjustViewBounds="true"
            android:background="@drawable/ad_button_bg" />
        <ImageView
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_centerHorizontal="true"
            android:src="@drawable/ad_roket"/>


    </RelativeLayout>
</LinearLayout>
