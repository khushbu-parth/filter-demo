<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#a6ffffff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/ad_background_exit"
        android:elevation="2sp"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:src="@drawable/ad_rate_image"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:text="Do You Like App?"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp"
            android:fontFamily="@font/ad_bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_rate_1"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="Thanks for leaving a nice review,it helps us lot."
            android:textColor="@color/black"
            android:textSize="@dimen/_14sdp" />
        <com.willy.ratingbar.ScaleRatingBar
            android:id="@+id/rotationratingbar_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp"
            app:srb_drawableEmpty="@drawable/ad_star_empty"
            app:srb_drawableFilled="@drawable/ad_star_filled"
            app:srb_numStars="5"
            app:srb_starHeight="@dimen/_32sdp"
            app:srb_starWidth="@dimen/_32sdp"
            app:srb_stepSize="1">

        </com.willy.ratingbar.ScaleRatingBar>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:elevation="@dimen/_5sdp"
                android:text="Rate App"
                android:fontFamily="@font/ad_light"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/white"
                android:paddingVertical="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:adjustViewBounds="true"
                android:background="@drawable/ad_button_bg" />
            <TextView
                android:id="@+id/tv_later"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:elevation="@dimen/_5sdp"
                android:text="Later"
                android:fontFamily="@font/ad_light"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/AdTextLight"
                android:paddingVertical="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_15sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:adjustViewBounds="true"
                android:background="@drawable/ad_button_bg4" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_never"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Never"
            android:fontFamily="@font/ad_light"
            android:textSize="@dimen/_10sdp"
            android:textColor="#828282"
            android:paddingVertical="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/_10sdp"
            android:adjustViewBounds="true"
            android:background="@drawable/ad_gray_bg" />
    </LinearLayout>
</FrameLayout>
