<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/adview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="invisible">

        <androidx.cardview.widget.CardView
            android:id="@+id/adview_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingLeft="5dp"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingBottom="5dp">

                <com.google.android.gms.ads.nativead.MediaView
                    android:id="@+id/ad_media"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"  />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/ad_app_icon"
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:src="@mipmap/ad_ic_launcher"
                            app:riv_corner_radius="@dimen/_7sdp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/_4sdp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:id="@+id/adText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="@dimen/_10sdp"
                                        android:layout_gravity="center"
                                        android:background="#000"
                                        android:fontFamily="@font/ad_semibold"
                                        android:gravity="center|center_vertical"
                                        android:includeFontPadding="false"
                                        android:paddingHorizontal="@dimen/_3sdp"
                                        android:text="Ad"
                                        android:textColor="#ffffff"
                                        android:textSize="@dimen/_6sdp"  />
                                </androidx.cardview.widget.CardView>

                                <TextView
                                    android:id="@+id/ad_headline"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/_4sdp"
                                    android:layout_marginRight="@dimen/_4sdp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/ad_semibold"
                                    android:gravity="center|left"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="dvc"
                                    android:textColor="#000"
                                    android:textSize="16sp"
                                    android:textStyle="bold"  />
                            </LinearLayout>


                            <TextView
                                android:id="@+id/ad_body"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/_4sdp"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:layout_marginRight="@dimen/_5sdp"
                                android:layout_marginBottom="@dimen/_2sdp"
                                android:layout_weight="1"
                                android:fontFamily="@font/ad_light"
                                android:gravity="center|left"
                                android:includeFontPadding="false"
                                android:maxLines="2"
                                android:minLines="2"
                                android:text="xdkcm"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_8sdp"
                                android:visibility="visible"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/ad_advertiser"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ad_light"
                                    android:gravity="bottom"
                                    android:includeFontPadding="false"
                                    android:textColor="#000"
                                    android:textSize="14sp"
                                    android:textStyle="normal"
                                    android:visibility="gone" />

                                <RatingBar
                                    android:id="@+id/ad_stars"
                                    style="?android:attr/ratingBarStyleSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:isIndicator="true"
                                    android:numStars="5"
                                    android:progressBackgroundTint="#FE6501"
                                    android:progressTint="#FE6501"
                                    android:secondaryProgressTint="#FE6501"
                                    android:stepSize="0.5" />

                                <TextView
                                    android:id="@+id/ad_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ad_light"
                                    android:includeFontPadding="false"
                                    android:textColor="#000"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/ad_store"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/ad_light"
                                    android:includeFontPadding="false"
                                    android:textColor="#000"
                                    android:textSize="12sp" />
                            </LinearLayout>


                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="5dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="@dimen/_4sdp"
                            app:cardElevation="0dp">

                            <TextView
                                android:id="@+id/ad_call_to_action"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_38sdp"
                                android:layout_gravity="center"
                                android:background="#000"
                                android:fontFamily="@font/ad_semibold"
                                android:gravity="center|center_vertical"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="3dp"
                                android:singleLine="true"
                                android:text="Install"
                                android:textAllCaps="true"
                                android:textColor="#ffffff"
                                android:textSize="13dp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


        </androidx.cardview.widget.CardView>
    </com.google.android.gms.ads.nativead.NativeAdView>
</FrameLayout>