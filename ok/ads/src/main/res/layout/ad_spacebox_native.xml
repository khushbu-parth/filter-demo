<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llSpaceBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <LinearLayout
        android:id="@+id/llBig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:shimmer_duration="1500"
            app:shimmer_highlight_color="@color/black"
            app:shimmer_shape="linear">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:id="@+id/rv1"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:background="#c2c2c2" />

                <RelativeLayout
                    android:id="@+id/rv2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_below="@+id/rv1"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:background="#c2c2c2" />

                <RelativeLayout
                    android:id="@+id/rv3"
                    android:layout_width="160dp"
                    android:layout_height="20dp"
                    android:layout_below="@+id/rv1"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:layout_toRightOf="@+id/rv2"
                    android:background="#c2c2c2" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="15dp"
                    android:layout_below="@+id/rv3"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_toRightOf="@+id/rv2"
                    android:background="#c2c2c2" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/rv2"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:background="#c2c2c2" />

            </RelativeLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llMid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:shimmer_duration="1500"
            app:shimmer_highlight_color="@color/black"
            app:shimmer_shape="linear">

            <RelativeLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:id="@+id/adview_card1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="5dp"

                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="5dp"
                        android:paddingTop="5dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="5dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:id="@+id/ad_app_icon1"
                                    android:layout_width="62dp"
                                    android:layout_height="62dp"
                                    android:layout_gravity="center"
                                    android:adjustViewBounds="true"
                                    android:background="#c2c2c2"
                                    app:riv_corner_radius="10dp" />

                                <com.google.android.gms.ads.nativead.MediaView
                                    android:id="@+id/ad_media1"
                                    android:layout_width="120dp"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center_horizontal"
                                    android:background="#c2c2c2"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="4dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:orientation="horizontal">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="20dp"
                                            android:layout_height="12dp"
                                            android:layout_marginLeft="4dp"
                                            android:background="#c2c2c2"
                                            app:cardElevation="0dp">

                                            <TextView
                                                android:id="@+id/adText1"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_gravity="center"
                                                android:background="#c2c2c2"
                                                android:fontFamily="@font/ad_light"
                                                android:gravity="center|center_vertical"
                                                android:includeFontPadding="false"
                                                android:paddingHorizontal="3dp"
                                                android:textSize="7dp" />
                                        </androidx.cardview.widget.CardView>

                                        <TextView
                                            android:id="@+id/ad_headline1"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginLeft="4dp"
                                            android:layout_marginRight="4dp"
                                            android:layout_weight="1"
                                            android:background="#c2c2c2"
                                            android:fontFamily="@font/ad_semibold"
                                            android:gravity="center|left"
                                            android:includeFontPadding="false"
                                            android:maxLines="1"
                                            android:singleLine="true"
                                            android:textColor="#000"
                                            android:textSize="16sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="4dp"
                                        android:layout_marginTop="2dp"
                                        android:background="#c2c2c2"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/ad_advertiser1"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/ad_light"
                                            android:gravity="bottom"
                                            android:includeFontPadding="false"
                                            android:textColor="#000"
                                            android:textSize="10dp"
                                            android:textStyle="normal"
                                            android:visibility="gone" />

                                        <RatingBar
                                            android:id="@+id/ad_stars1"
                                            style="?android:attr/ratingBarStyleSmall"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:isIndicator="true"
                                            android:numStars="5"
                                            android:progressBackgroundTint="#FE6501"
                                            android:progressTint="#FE6501"
                                            android:secondaryProgressTint="#FE6501"
                                            android:stepSize="0.5"
                                            android:visibility="gone" />

                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/ad_body1"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="4dp"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginRight="5dp"
                                        android:layout_marginBottom="2dp"
                                        android:layout_weight="1"
                                        android:background="#c2c2c2"
                                        android:fontFamily="@font/ad_light"
                                        android:gravity="center|left"
                                        android:includeFontPadding="false"
                                        android:maxLines="2"
                                        android:minLines="2"
                                        android:textColor="@color/black"
                                        android:textSize="8dp"
                                        android:visibility="visible" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:visibility="gone">

                                        <TextView
                                            android:id="@+id/ad_price1"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/ad_light"
                                            android:includeFontPadding="false"
                                            android:paddingHorizontal="4dp"
                                            android:textColor="#000"
                                            android:textSize="12dp" />

                                        <TextView
                                            android:id="@+id/ad_store1"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:fontFamily="@font/ad_light"
                                            android:includeFontPadding="false"
                                            android:paddingHorizontal="4dp"
                                            android:textColor="#000"
                                            android:textSize="10dp" />
                                    </LinearLayout>

                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="#c2c2c2"
                                    app:cardCornerRadius="4dp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:id="@+id/ad_call_to_action1"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:layout_gravity="center"
                                        android:background="#c2c2c2"
                                        android:fontFamily="@font/ad_semibold"
                                        android:gravity="center|center_vertical"
                                        android:includeFontPadding="false"
                                        android:paddingHorizontal="3dp"
                                        android:singleLine="true"
                                        android:textAllCaps="true"
                                        android:textColor="#ffffff"
                                        android:textSize="13dp"
                                        android:textStyle="bold" />
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </RelativeLayout>


        </com.facebook.shimmer.ShimmerFrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSml"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_duration="1500"
            app:shimmer_highlight_color="@color/black"
            app:shimmer_shape="linear">

            <androidx.cardview.widget.CardView
                android:id="@+id/adview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Other Content-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <!-- App Icon-->
                            <ImageView
                                android:id="@+id/ad_app_icon"
                                android:layout_width="65dp"
                                android:layout_height="65dp"
                                android:layout_marginLeft="5dp"
                                android:background="#c2c2c2"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:adjustViewBounds="true" />

                            <!-- HeadLine and SubText-->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginHorizontal="4dp"
                                android:layout_weight="1"
                                android:layout_marginBottom="8dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="20dp"
                                        android:layout_height="12dp"
                                        android:layout_marginTop="2dp"
                                        app:cardElevation="0dp">

                                        <TextView
                                            android:id="@+id/adText"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_gravity="center"
                                            android:fontFamily="@font/ad_light"
                                            android:gravity="center|center_vertical"
                                            android:includeFontPadding="false"
                                            android:paddingHorizontal="3dp"
                                            android:background="#c2c2c2"
                                            android:textSize="7dp" />
                                    </androidx.cardview.widget.CardView>

                                    <!-- Heading-->
                                    <TextView
                                        android:id="@+id/ad_headline"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="2dp"
                                        android:background="#c2c2c2"
                                        android:fontFamily="@font/ad_semibold"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:textColor="#000"
                                        android:textSize="15dp"
                                        android:textStyle="bold" />

                                </LinearLayout>


                                <TextView
                                    android:id="@+id/ad_body"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/ad_light"
                                    android:includeFontPadding="false"
                                    android:maxLines="2"
                                    android:background="#c2c2c2"
                                    android:minLines="2"
                                    android:textColor="@color/black"
                                    android:textSize="9dp" />


                            </LinearLayout>

                            <!-- Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ad_call_to_action"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginRight="5dp"
                                android:fontFamily="@font/ad_semibold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textAllCaps="true"
                                android:textColor="#fff"
                                android:textSize="10dp"
                                app:backgroundTint="#c2c2c2"
                                app:strokeColor="@color/white"
                                app:strokeWidth="0dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </com.facebook.shimmer.ShimmerFrameLayout>


    </LinearLayout>

</RelativeLayout>